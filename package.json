{
  "name": "beta",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server",
    "build": "tsc && npm run build:client",
    "build:client": "vite build --outDir dist/client && npm run build:server && npm run prerender",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "prerender": "node scripts/prerender.js",
    "build:gh-pages": "npm run build:client",
    "preview": "cross-env NODE_ENV=production node server"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2"
  }
}
